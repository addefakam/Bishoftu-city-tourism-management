// Bishoftu City Tourism Management System — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hotel {
  id             String   @id @default(cuid())
  name           String
  description    String
  starRating     Int      // 1-5
  type           String   // hotel, resort, motel, lodge
  subCity        String
  address        String
  pricePerNight  Int?     // ETB per night
  totalRooms     Int
  occupiedRooms  Int      @default(0)
  imageUrl       String?
  phone          String?
  email          String?
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Photos uploaded by tourists from the hotel cards on the /hotels page.
// Stored as base64 data URLs (compressed client-side to ≤1280px JPEG).
// One current photo per hotel — a new upload replaces the previous one.
model TouristPhoto {
  id        String   @id @default(cuid())
  hotelId   String   @unique
  dataUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attraction {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   // lake, hot_spring, museum, church, park, viewpoint, wetland
  subCity     String?
  imageUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  content     String?
  hotelName   String?
  publishedAt DateTime @default(now())
}

model Business {
  id        String   @id @default(cuid())
  name      String
  type      String
  subCity   String
  createdAt DateTime @default(now())
}

// Configurable site images — lets the tourism admin replace hardcoded
// photos (hero background, virtual Bishoftu, attraction cards, etc.)
// with uploaded images. Stored as base64 data URLs in SQLite, or as
// Vercel Blob URLs when BLOB storage is configured.
model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "hero_background", "virtual_bishoftu", "attraction_<id>"
  url       String   // data URL or blob URL
  label     String   // human-readable label for admin UI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Generic key/value store for editable site-wide content (footer text,
// contact info, link lists, copyright, etc.). The `value` column holds
// a JSON string. Currently consumed by the FooterManager (tourism admin).
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "footer"
  value     String   // JSON-encoded value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
